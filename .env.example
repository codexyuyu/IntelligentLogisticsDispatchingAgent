# Copy to .env and fill real values before running services.
# The placeholder key is intentionally rejected by the provider adapter; replace it.
DEEPSEEK_API_KEY=sk-placeholder
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_S=30

# Backend/worker settings (JSON, one line). Do not commit real credentials.
# LOGISTICS_SETTINGS_JSON={"mode":"development","database_url":"postgresql+psycopg://user:password@127.0.0.1:5432/logistics","scope_id":"11111111-1111-4111-8111-111111111111","credentials":[{"actor_id":"22222222-2222-4222-8222-222222222222","role":"operator","token_sha256":"<sha256-of-dev-token>"}]}
