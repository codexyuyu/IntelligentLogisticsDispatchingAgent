{
  "name": "@logistics/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "React workbench shell for the logistics dispatching system.",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "contracts:generate": "node ./scripts/generate-contracts.mjs --write",
    "contracts:check": "node ./scripts/generate-contracts.mjs --check"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
