{
  "name": "logistics-demo-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "contracts:generate": "node scripts/contracts.mjs",
    "contracts:check": "node scripts/contracts.mjs --check",
    "test:evidence": "node scripts/test-r15-evidence.cjs",
    "test:speed": "node scripts/test-r16-speed.cjs",
    "prebuild": "npm run contracts:check",
    "test:pg-ui": "node scripts/test-r23-pg-ui.cjs",
    "test:r25": "node scripts/test-r25-replay.cjs",
    "test:r26": "node scripts/test-r26-warehouse.cjs",
    "test:r27": "node scripts/test-r27-flow.cjs",
    "test:r28": "node scripts/test-r28-reconciliation.cjs",
    "test:r29": "node scripts/test-r29-active.cjs",
    "test:r30a": "node scripts/test-r30a-pg.cjs",
    "test:r30c": "node scripts/test-r30c-agent.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-r15-evidence.cjs && node scripts/test-r16-speed.cjs && node scripts/test-r23-pg-ui.cjs && node scripts/test-r25-replay.cjs && node scripts/test-r26-warehouse.cjs && node scripts/test-r27-flow.cjs && node scripts/test-r28-reconciliation.cjs && node scripts/test-r29-active.cjs && node scripts/test-r30a-pg.cjs && node scripts/test-r30c-agent.cjs"
  },
  "dependencies": {
    "openapi-fetch": "^0.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "openapi-typescript": "^7.9.1",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  }
}
